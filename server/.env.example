# Set to production for deployment; development is suitable locally.
NODE_ENV=development
# Optional; defaults to 8000 (production hosts commonly set PORT themselves).
PORT=8000
# Required in production; the API's public HTTPS URL.
APP_URL=http://localhost:8000
# Optional; defaults to 5mb.
JSON_BODY_LIMIT=5mb
# Required in production. Development defaults to http://localhost:5173.
ORIGINS=http://localhost:5173
# Required to start the API.
MONGODB_URI=mongodb://127.0.0.1:27017/builderai
JWT_SECRET=replace-with-at-least-32-random-bytes
# Optional; defaults to lax. Use none only when frontend and API are cross-site.
COOKIE_SAME_SITE=lax
# Required for AI generation and chat; never set this in the client.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# Optional model/concurrency overrides.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=openrouter/free
AI_MAX_CONCURRENCY=6